        / nullif(count(distinct primry_ownr_cl_id), 0), 1)
        as ppg_sales_gm,
    round(
        count(distinct case when fp_flag = 'Y' then primry_ownr_cl_id end) * 100.0
        / nullif(count(distinct primry_ownr_cl_id), 0), 1)
        as ppg_sales_fp,
    round(
        count(distinct case when gm_flag = 'Y' or fp_flag = 'Y' then primry_ownr_cl_id end) * 100.0
        / nullif(count(distinct primry_ownr_cl_id), 0), 1)
