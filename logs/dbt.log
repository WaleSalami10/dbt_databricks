`dbt_osalami_staging`.`stg_pdm__ytd_dates`\n)\n\nselect distinct\n    mapp.snapshot_date,\n    dt.ytd_end_dt          as month_end_date,\n    mapp.lob_nm,\n    mapp.cnt_id_nk,\n    mapp.cnt_iss_cd_nk,\n    mapp.cnt_eff_dt,\n    mapp.primry_ownr_cl_id,\n    mapp.producer_id_nk,\n    mapp.producer_cnt_role_nm,\n    mapp.product_category_protection_accumulation_alternate,\n    mapp.product_category_need_based_by_product,\n    mapp.product_category_risk_wm,\n    mapp.product_type\nfrom mapping mapp\ninner join dates dt\n    on mapp.cnt_eff_dt <= dt.ytd_end_dt\n) select primry_ownr_cl_id\nfrom __dbt__cte__int_metrics__base_all\nwhere primry_ownr_cl_id is null\n\n\n\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7bf645fc-92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On test.ppg.not_null_int_metrics__base_all_primry_ownr_cl_id.9ebb91c56b: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.not_null_int_metrics__base_all_primry_ownr_cl_id.9ebb91c56b\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  \n    \n    \n\n\n\nwith __dbt__cte__int_metrics__base_all as (\n-- Original CTE: base_all\n--\n-- \u26a0 BEHAVIOUR CHANGE FORCED BY THE CELL 1 REFACTOR \u26a0\n-- The original read ppg_stg_cnt_prd_mapping unfiltered, which was safe only\n-- because cell 1 did `create or replace` and the table held exactly one\n-- snapshot. ppg_stg_cnt_prd_mapping is now incremental and retains history, so\n-- reading it unfiltered would multiply every metric by the number of snapshots\n-- retained. The snapshot_date filter below is mandatory, not optional.\nwith mapping as (\n    select *\n    from `dbt-dev-catalog`.`dbt_osalami_marts`.`ppg_stg_cnt_prd_mapping`\n    where snapshot_date = current_date\n),\n\ndates as (\n    select * from `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates`\n)\n\nselect distinct\n    mapp.snapshot_date,\n    dt.ytd_end_dt          as month_end_date,\n    mapp.lob_nm,\n    mapp.cnt_id_nk,\n    mapp.cnt_iss_cd_nk,\n    mapp.cnt_eff_dt,\n    mapp.primry_ownr_cl_id,\n    mapp.producer_id_nk,\n    mapp.producer_cnt_role_nm,\n    mapp.product_category_protection_accumulation_alternate,\n    mapp.product_category_need_based_by_product,\n    mapp.product_category_risk_wm,\n    mapp.product_type\nfrom mapping mapp\ninner join dates dt\n    on mapp.cnt_eff_dt <= dt.ytd_end_dt\n) select primry_ownr_cl_id\nfrom __dbt__cte__int_metrics__base_all\nwhere primry_ownr_cl_id is null\n\n\n\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 94, "thread": "Thread-8 (worker)", "ts": "2026-08-02T02:15:33.067625Z"}}
