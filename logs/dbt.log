{"data": {"conn_name": "model.ppg.ppg_metrics_monthly", "node_info": {"materialized": "incremental", "meta": {}, "node_checksum": "7cfa295c328b88bf4bb611bde0bd4b73b5e58acf3e0b449cd4e6a5ca037e0135", "node_finished_at": "", "node_name": "ppg_metrics_monthly", "node_path": "marts/ppg_metrics_monthly.sql", "node_relation": {"alias": "ppg_metrics_monthly", "database": "dbt-dev-catalog", "relation_name": "`dbt-dev-catalog`.`dbt_osalami_marts`.`ppg_metrics_monthly`", "schema": "dbt_osalami_marts"}, "node_started_at": "2026-08-02T02:15:41.032395", "node_status": "executing", "resource_type": "model", "unique_id": "model.ppg.ppg_metrics_monthly"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"model.ppg.ppg_metrics_monthly\"} */\n\n  \n    \n        create or replace table `dbt-dev-catalog`.`dbt_osalami_marts`.`ppg_metrics_monthly`\n      \n      \n    using delta\n  \n      \n      partitioned by (month_end_date)\n      \n      \n      \n      \n      \n      \n      as\n      -- Original: cell 3, INSERT INTO prod_builder_fieldexperience.ppg.ppg_metrics_monthly\n--\n-- WHAT THIS MODEL ACTUALLY DOES\n-- It is ppg_metrics_dtl with two columns removed -- cnt_iss_cd_nk and\n-- producer_cnt_role_nm -- and a `distinct` on top. That is not a cosmetic\n-- projection: it is a deliberate grain reduction. See the note in the README.\n--\n-- The original's `INNER JOIN dates dt ON dt.ytd_end_dt = month_end_date` was\n-- doing the job dbt's incremental config now does: pick the one month to\n-- append. Kept as an explicit filter so a run is idempotent for a given\n-- snapshot_date and `--vars` backfill still works.\n\nwith dtl as (\n\n    select * from `dbt-dev-catalog`.`dbt_osalami_marts`.`ppg_metrics_dtl`\n\n    \n    -- Restrict to the reporting month, exactly as the original did.\n    where month_end_date = (select ytd_end_dt from `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates`)\n    \n\n),\n\ncurrent_load as (\n\n    select distinct\n        snapshot_date,\n        month_end_date,\n        lob_nm,\n        primry_ownr_cl_id,\n        cnt_id_nk,\n        cnt_eff_dt,\n        producer_id_nk,\n        product_category_protection_accumulation_alternate,\n        product_category_need_based_by_product,\n        product_category_risk_wm,\n        product_type,\n        risk_management_ind,\n        wealth_management_ind,\n        gm_flag,\n        fp_flag,\n        gm_or_fp_flag\n    from dtl\n\n)\n\n\n\nselect * from current_load\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7bf645fc-92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On model.ppg.ppg_metrics_monthly: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"model.ppg.ppg_metrics_monthly\"} */\n\n  \n    \n        create or replace table `dbt-dev-catalog`.`dbt_osalami_marts`.`ppg_metrics_monthly`\n      \n      \n    using delta\n  \n      \n      partitioned by (month_end_date)\n      \n      \n      \n      \n      \n      \n      as\n      -- Original: cell 3, INSERT INTO prod_builder_fieldexperience.ppg.ppg_metrics_monthly\n--\n-- WHAT THIS MODEL ACTUALLY DOES\n-- It is ppg_metrics_dtl with two columns removed -- cnt_iss_cd_nk and\n-- producer_cnt_role_nm -- and a `distinct` on top. That is not a cosmetic\n-- projection: it is a deliberate grain reduction. See the note in the README.\n--\n-- The original's `INNER JOIN dates dt ON dt.ytd_end_dt = month_end_date` was\n-- doing