log`.`dbt_osalami_staging`.`stg_digital__gm_plan_dates`\n  \n  as (\n    -- Guided Meeting PPG plan dates.\nselect\n    salesforce_id,\n    completed_plan_dt,\n    type\nfrom `prod_execution_fieldexperience`.`digital`.`mt__gm_ppg_plan_dates`\nwhere type <> 'FB'\n  )\n", "name": "SQLQuery", "pid": 94, "thread": "Thread-6 (worker)", "ts": "2026-08-02T02:14:55.500748Z"}}
