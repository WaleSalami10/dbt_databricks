{"data": {"conn_name": "test.ppg.assert_depth_collapse_types_exist", "node_info": {"materialized": "test", "meta": {}, "node_checksum": "5f28ef3597f226c065d51fa90b421ac4b67a05893a234cbb2a3d0053403fdc15", "node_finished_at": "", "node_name": "assert_depth_collapse_types_exist", "node_path": "assert_depth_collapse_types_exist.sql", "node_relation": {"alias": "assert_depth_collapse_types_exist", "database": "dbt-dev-catalog", "relation_name": "", "schema": "dbt_osalami_dbt_test__audit"}, "node_started_at": "2026-08-02T02:15:11.104147", "node_status": "executing", "resource_type": "test", "unique_id": "test.ppg.assert_depth_collapse_types_exist"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.assert_depth_collapse_types_exist\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- int_summ__client_breadth_depth collapses a hard-coded set of product_type\n-- values into a single 'TERM' unit when computing depth. Those strings are\n-- produced by seeds/product_category_map.csv. If somebody renames a product\n-- type in the seed, the depth rule silently stops collapsing and every client\n-- with term policies gets a higher depth, with no error anywhere.\n--\n-- This test fails if any configured value no longer exists in the seed.\n\n\nwith expected as (\n    \n    select 'Level Term and Level Convertible_Renewable Term' as product_type\n    union all\n    \n    select 'Yearly Convertible_Renewable Term' as product_type\n    \n    \n)\n\nselect e.product_type\nfrom expected e\nleft join `dbt-dev-catalog`.`dbt_osalami_seeds`.`product_category_map` m\n    on m.product_type = e.product_type\nwhere m.product_type is null\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7bf645fc-92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On test.ppg.assert_depth_collapse_types_exist: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.assert_depth_collapse_types_exist\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  -- int_summ__client_breadth_depth collapses a hard-coded set of product_type\n-- values into a single 'TERM' unit when computing depth. Those strings are\n-- produced by seeds/product_category_map.csv. If somebody renames a product\n-- type in the seed, the depth rule silently stops collapsing and every client\n-- with term policies gets a higher depth, with no error anywhere.\n--\n-- This test fails if any configured value no longer exists in the seed.\n\n\nwith expected as (\n    \n    select 'Level Term and Level Convertible_Renewable Term' as product_type\n    union all\n    \n    select 'Yearly Convertible_Renewable Term' as product_type\n    \n    \n)\n\nselect e.product_type\nfrom expected e\nleft join `dbt-dev-catalog`.`dbt_osalami_seeds`.`product_category_map` m\n    on m.product_type = e.product_type\nwhere m.product_type is null\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 94, "thread": "Thread-7 (worker)", "ts": "2026-08-02T02:15:11.168233Z"}}
