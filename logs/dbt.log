    min(gm.completed_plan_dt)       as completed_plan_dt
from `dbt_dev`.`dbt_osalami_staging`.`stg_digital__gm_plan_dates` gm
inner join `dbt_dev`.`dbt_osalami_staging`.`stg_crm__sf_account` acct
