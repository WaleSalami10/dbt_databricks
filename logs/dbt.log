{"data": {"conn_name": "test.ppg.unique_int_planning__gm_clients_client_id.25e1949c66", "node_info": {"materialized": "test", "meta": {}, "node_checksum": "", "node_finished_at": "", "node_name": "unique_int_planning__gm_clients_client_id", "node_path": "unique_int_planning__gm_clients_client_id.sql", "node_relation": {"alias": "unique_int_planning__gm_clients_client_id", "database": "dbt-dev-catalog", "relation_name": "", "schema": "dbt_osalami_dbt_test__audit"}, "node_started_at": "2026-08-02T02:15:12.076889", "node_status": "executing", "resource_type": "test", "unique_id": "test.ppg.unique_int_planning__gm_clients_client_id.25e1949c66"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.unique_int_planning__gm_clients_client_id.25e1949c66\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  \n    \n    \n\nwith __dbt__cte__int_planning__gm_clients as (\n-- The sf_account -> gm plan dates join that the original pasted THREE times:\n-- once inside clients_with_planning, and twice more inside\n-- clients_with_planning_v2. Defined once here.\nselect\n    acct.case_cl_id                 as client_id,\n    min(gm.completed_plan_dt)       as completed_plan_dt\nfrom `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_digital__gm_plan_dates` gm\ninner join `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_crm__sf_account` acct\n    on acct.acct_id_nk = gm.salesforce_id\ngroup by 1\n) select\n    client_id as unique_field,\n    count(*) as n_records\n\nfrom __dbt__cte__int_planning__gm_clients\nwhere client_id is not null\ngroup by client_id\nhaving count(*) > 1\n\n\n\n  \n  \n      \n    ) dbt_internal_test"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7bf645fc-92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On test.ppg.unique_int_planning__gm_clients_client_id.25e1949c66: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.unique_int_planning__gm_clients_client_id.25e1949c66\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  \n    \n    \n\nwith __dbt__cte__int_planning__gm_clients as (\n-- The sf_account -> gm plan dates join that the original pasted THREE times:\n-- once inside clients_with_planning, and twice more inside\n-- clients_with_planning_v2. Defined once here.\nselect\n    acct.case_cl_id                 as client_id,\n    min(gm.completed_plan_dt)       as completed_plan_dt\nfrom `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_digital__gm_plan_dates` gm\ninner join `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_crm__sf_account` acct\n    on acct.acct_id_nk = gm.salesforce_id\ngroup by 1\n) select\n    client_id as unique_field,\n    count(*) as n_records\n\nfrom __dbt__cte__int_planning__gm_clients\nwhere client_id is not null\ngroup by client_id\nhaving count(*) > 1\n\n\n\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 94, "thread": "Thread-7 (worker)", "ts": "2026-08-02T02:15:12.150381Z"}}
