g": "On test.ppg.not_null_int_contracts__scoped_cnt_id_nk.f41f183cdb: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.not_null_int_contracts__scoped_cnt_id_nk.f41f183cdb\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  \n    \n    \n\n\n\nwith __dbt__cte__int_contracts__scoped as (\n-- Original CTE: core_contracts\n-- Contracts in scope for PPG, with the IDI override applied to lob_nm.\nselect distinct\n    case\n        when cnt_iss_cd_nk = 'IDI' then 'IDI'\n        else lob_nm\n    end                 as lob_nm,\n    plan_cd,\n    cnt_id_nk,\n    cnt_iss_cd_nk,\n    cnt_eff_dt\nfrom `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__contracts`\nwhere lob_nm in ('LIFE INSURANCE', 'ANNUITIES', 'LONG TERM CARE')\n   or cnt_iss_cd_nk = 'IDI'\n) select cnt_id_nk\nfrom __dbt__cte__int_contracts__scoped\nwhere cnt_id_nk is null\n\n\n\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 94, "thread": "Thread-8 (worker)", "ts": "2026-08-02T02:15:09.518616Z"}}
