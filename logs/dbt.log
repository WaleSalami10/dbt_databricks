    from __dbt__cte__int_contracts__scoped
    group by cnt_id_nk, cnt_iss_cd_nk, plan_cd
    having count(*) > 1

)

select *
from validation_errors



--EPHEMERAL-SELECT-WRAPPER-END
)
  
  
      
