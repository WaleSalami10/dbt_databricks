92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On test.ppg.unique_int_clients__active_eop_po_client_id_nk.d33fe6dfaa: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"test.ppg.unique_int_clients__active_eop_po_client_id_nk.d33fe6dfaa\"} */\n\n    \n    select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  \n    \n    \n\nwith __dbt__cte__int_clients__active_eop as (\n-- Original CTE: get_active_cl_eop\n-- Clients with an active policy-owner record as of the reporting month end.\nselect distinct\n    po.po_client_id_nk,\n    dt.ytd_end_dt\nfrom `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_metrics__policy_owner` po\ninner join `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates` dt\n    on po.dt_key = dt.ytd_end_dim_sqn\n) select\n    po_client_id_nk as unique_field,\n    count(*) as n_records\n\nfrom __dbt__cte__int_clients__active_eop\nwhere po_client_id_nk is not null\ngroup by po_client_id_nk\nhaving count(*) > 1\n\n\n\n  \n  \n      \n    ) dbt_internal_test", "name": "SQLQuery", "pid": 94, "thread": "Thread-8 (worker)", "ts": "2026-08-02T02:15:12.387232Z"}}
