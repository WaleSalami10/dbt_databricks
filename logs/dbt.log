{"data": {"conn_name": "model.ppg.stg_pdm__ytd_dates", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "2c94571295ba4906d8e0e81fad21e5d08d2fbb9904f2d8d6e5a6bb6af73de674", "node_finished_at": "", "node_name": "stg_pdm__ytd_dates", "node_path": "staging/stg_pdm__ytd_dates.sql", "node_relation": {"alias": "stg_pdm__ytd_dates", "database": "dbt-dev-catalog", "relation_name": "`dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates`", "schema": "dbt_osalami_staging"}, "node_started_at": "2026-08-02T02:15:00.757502", "node_status": "executing", "resource_type": "model", "unique_id": "model.ppg.stg_pdm__ytd_dates"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"model.ppg.stg_pdm__ytd_dates\"} */\n\n  \n  \n  \n  create or replace view `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates`\n  \n  as (\n    -- Replaces the `dates` CTE in cell 2 (ppg_metrics_dtl).\n--\n-- Cell 1 anchored on CURRENT_DATE and derived month end as mth_begin_dt - 1.\n-- Cell 2 anchored on ADD_MONTHS(CURRENT_DATE, -1) and took mth_end_dt directly.\n-- Two different computations of the same value. They agree today, but they are\n-- independent, so a change to dim_date could silently split them. The test in\n-- _staging.yml asserts month_end_date = ytd_end_dt on every run.\nselect distinct\n    to_date(date_trunc('year', mth_end_dt))      as ytd_begin_dt,\n    mth_end_dt                                   as ytd_end_dt,\n    date_format(mth_end_dt, 'yyyyMMdd')          as ytd_end_dim_sqn\nfrom `prod_execution_rs`.`ext_pdm`.`dim_date`\nwhere clndr_dt = add_months(current_date, -1)\n  )\n"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "7bf645fc-92f1-481f-a80d-d5102319461e", "level": "debug", "msg": "On model.ppg.stg_pdm__ytd_dates: /* {\"app\": \"dbt\", \"dbt_version\": \"2026.7.28+709584c\", \"dbt_databricks_version\": \"1.12.2post1+2d0fbe9e93588c9f24af3b6a4b5b571015752b17\", \"databricks_sql_connector_version\": \"4.1.3\", \"profile_name\": \"user\", \"target_name\": \"default\", \"invocation_id\": \"cc8ba0d5-accc-45f3-b13c-b734d95bacaa\", \"node_id\": \"model.ppg.stg_pdm__ytd_dates\"} */\n\n  \n  \n  \n  create or replace view `dbt-dev-catalog`.`dbt_osalami_staging`.`stg_pdm__ytd_dates`\n  \n  as (\n    -- Replaces the `dates` CTE in cell 2 (ppg_metrics_dtl).\n--\n-- Cell 1 anchored on CURRENT_DATE and derived month end as mth_begin_dt - 1.\n-- Cell 2 anchored on ADD_MONTHS(CURRENT_DATE, -1) and took mth_end_dt directly.\n-- Two different computations of the same value. They agree today, but they are\n-- independent, so a change to dim_date could silently split them. The test in\n-- _staging.yml asserts month_end_date = ytd_end_dt on every run.\nselect distinct\n    to_date(date_trunc('year', mth_end_dt))      as ytd_begin_dt,\n    mth_end_dt                                   as ytd_end_dt,\n    date_format(mth_end_dt, 'yyyyMMdd')          as ytd_end_dim_sqn\nfrom `prod_execution_rs`.`ext_pdm`.`dim_date`\nwhere clndr_dt = add_months(current_date, -1)\n  )\n", "name": "SQLQuery", "pid": 94, "thread": "Thread-8 (worker)", "ts": "2026-08-02T02:15:00.842076Z"}}
